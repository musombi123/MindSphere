{
  "name": "project-zero-hour",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run assets:prepare && npm run assets:validate && vite --host 0.0.0.0",
    "assets:prepare": "node scripts/prepare-runtime-assets.mjs",
    "build": "npm run assets:prepare && npm run assets:validate && npm run test:tactical && npm run test:weather && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "postinstall": "node scripts/copy-three-decoders.mjs",
    "assets:validate": "node scripts/validate-runtime-assets.mjs",
    "test:tactical": "node scripts/test-tactical-ai.mjs",
    "test:weather": "node scripts/test-weather.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.9.17"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "vite": "^6.4.1"
  }
}
